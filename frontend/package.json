{
  "name": "internship-workbench-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript ../backend/openapi/openapi.json -o src/api/schema.ts",
    "test": "vitest run",
    "e2e": "node e2e/workbench-flow.mjs",
    "e2e:responsive": "node e2e/responsive.mjs",
    "e2e:demo": "node e2e/plan-states.mjs",
    "e2e:guest": "node e2e/guest-session.mjs",
    "e2e:offline": "node e2e/offline-reload.mjs",
    "e2e:roles": "node e2e/roles.mjs",
    "e2e:tracking": "node e2e/tracking-recovery.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "e2e:ai-settings": "node e2e/ai-settings.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "dexie": "^4.0.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.4.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.25.4": true,
    "sharp@0.33.5": true,
    "workerd@1.20251011.0": true
  }
}
