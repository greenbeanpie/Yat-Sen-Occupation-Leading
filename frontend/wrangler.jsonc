{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenbp-intern-workbench",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [{ "pattern": "intern.greenbp.dpdns.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/v1", "/api/v1/*"],
    "not_found_handling": "single-page-application"
  },
  "services": [{ "binding": "BACKEND", "service": "greenbp-intern-workbench-backend" }]
}
