{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yso-internship-workbench-frontend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/v1", "/api/v1/*"],
    "not_found_handling": "single-page-application"
  },
  "services": [{ "binding": "BACKEND", "service": "yso-backend" }]
}
