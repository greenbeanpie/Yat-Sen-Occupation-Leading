{
  "name": "yso-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "generate:vapid": "tsx scripts/generate-vapid.ts",
    "gen:migrations": "tsx scripts/gen-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.0",
    "hono": "^4.10.0",
    "unpdf": "^1.3.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.18.0",
    "fflate": "^0.8.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "4.44.0"
  },
  "allowScripts": {
    "workerd@1.20251011.0": true,
    "workerd@1.20260926.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true,
    "sharp@0.35.4": true
  }
}
